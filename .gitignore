# ── Ваше личное: на полку не уезжает ───────────────────────────────
профили/*
!профили/_шаблон/
!профили/README.md
профили/_активный

# Ваши сайты и всё, что система по ним собрала
сайты/*
!сайты/.gitkeep

# Ключи и настройки машины
.claude/settings.local.json
.env
*.key

# Окружение и мусор
.venv/
__pycache__/
*.pyc
.DS_Store
